generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  ratings   Rating[]
  skips     Skip[]
  listAdded  ShoppingItem[] @relation("addedBy")
  listBought ShoppingItem[] @relation("boughtBy")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  brand      String?
  ean        String?  @unique
  categoryId Int
  imageUrl   String?
  nutriScore String?
  // Nutrition values per 100 g
  calories   Float?
  protein    Float?
  carbs      Float?
  sugar      Float?
  fat        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  ratings  Rating[]
  skips    Skip[]
  listItems ShoppingItem[]
}

model Rating {
  id           Int      @id @default(autoincrement())
  score        Int
  note         String?
  productId    Int
  personId     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([productId, personId])
}

// "I will not rate this": the product stops waiting for this person's rating
model Skip {
  id        Int      @id @default(autoincrement())
  productId Int
  personId  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([productId, personId])
}

// Shared shopping list. The id comes from the phone, so an offline change can be retried safely.
model ShoppingItem {
  id         String    @id
  text       String
  productId  Int?
  addedById  Int
  boughtById Int?
  boughtAt   DateTime?
  // Set instead of deleting, so a delayed "add" from the other phone cannot bring the item back
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  addedBy  Person   @relation("addedBy", fields: [addedById], references: [id], onDelete: Cascade)
  boughtBy Person?  @relation("boughtBy", fields: [boughtById], references: [id], onDelete: SetNull)
}

// App-wide settings set from the settings screen; secrets are stored encrypted
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Failed household password attempts, for limiting guessing (serverless has no shared memory)
model LoginFailure {
  id        Int      @id @default(autoincrement())
  ip        String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

// Per-day usage counters for paid or limited services, e.g. "recognize:2026-09-26"
model UsageCounter {
  key   String @id
  count Int    @default(0)
}

// "Zgłoś problem" from settings, plus errors caught by the error screen
model Feedback {
  id        Int      @id @default(autoincrement())
  kind      String // "report" or "error"
  message   String
  personId  Int?
  version   String?
  page      String?
  userAgent String?
  createdAt DateTime @default(now())
}
